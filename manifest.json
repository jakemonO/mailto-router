{
  "manifest_version": 3,
  "name": "Mailto Router",
  "version": "1.0.0",
  "description": "Open mailto: links in any webmail provider you define, using URL templates with {to}, {cc}, {bcc}, {subject} and {body} placeholders.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailto-router@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage"],
  "protocol_handlers": [
    {
      "protocol": "mailto",
      "name": "Mailto Router",
      "uriTemplate": "/handler.html#%s"
    }
  ],
  "action": {
    "default_title": "Mailto Router settings",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
